# Documentation only. npm run dev:init generates .env.local with random credentials.
# Do not source this file or reuse its placeholders. Do not use production secrets.
COMPOSE_PROJECT_NAME=loom-dev
LOOM_POSTGRES_PORT=54320
LOOM_S3_PORT=8333
LOOM_PG_BOOTSTRAP_PASSWORD=GENERATED_BY_DEV_INIT
LOOM_PG_MIGRATOR_PASSWORD=GENERATED_BY_DEV_INIT
LOOM_PG_APP_PASSWORD=GENERATED_BY_DEV_INIT
LOOM_S3_ACCESS_KEY=GENERATED_BY_DEV_INIT
LOOM_S3_SECRET_KEY=GENERATED_BY_DEV_INIT
LOOM_S3_STAGING_BUCKET=loom-dev-staging
LOOM_S3_FINAL_BUCKET=loom-dev-final
